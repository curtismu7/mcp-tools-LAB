# Copy to .env (git-ignored). Nothing here is required. Never commit real secrets.

# Port (default 4810). Dev UI (Vite) is 4811.
# PORT=4810

# Bind address. Default 127.0.0.1 (loopback only). Any other value is an explicit opt-in:
# the server then also accepts the Host headers listed in MCPTOOLS_ALLOWED_HOSTS (comma-separated host names).
# MCPTOOLS_BIND=
# MCPTOOLS_ALLOWED_HOSTS=

# Where saved connections live (connections.json, mode 600). Default ~/.mcp-tools
# DATA_DIR=

# Largest tools/list snapshot POST /api/scan accepts, in bytes (default 1048576).
# MCPTOOLS_SCAN_MAX_BYTES=

# Optional, off by default, untested in this repo: PingOne's hosted MCP server as a connection type.
# Needs your own PingOne OIDC app (public client, PKCE S256, redirect URI http://127.0.0.1:PORT/api/pingone/callback).
# MCPTOOLS_PINGONE=1
# PINGONE_ENVIRONMENT_ID=
# PINGONE_MCP_CLIENT_ID=
# PINGONE_REGION=com
