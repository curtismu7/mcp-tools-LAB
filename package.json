{
  "name": "mcp-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP tools: connect to an MCP server, list its tools, scan the metadata before an agent ingests it, then call tools with an explicit confirm step.",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w web",
    "build": "npm run build -w web",
    "scan": "node server/src/scanner/cli.js",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "e2e": "node scripts/e2e.mjs",
    "content-pack": "node scripts/build-content-pack.mjs && node scripts/validate-content-pack.mjs",
    "docs": "node scripts/build-scan-rules.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.58.2"
  }
}
